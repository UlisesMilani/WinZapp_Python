+// SetAudioTimestampStride changes only the codec clock step. The caller owns
+// serialization; sequence, timestamp, SSRC and SRTP ROC are never reset.
+func (s *RtpStream) SetAudioTimestampStride(samples uint32) {
+	if samples != 0 {
+		s.samplesPerPacket = samples
+	}
+}
